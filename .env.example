# Local development: copy .env.local.example to .env.local (points at `supabase start`; takes precedence over .env).
# This file documents the variable names of a REAL project (Supabase dashboard -> Project Settings -> API / Database).
# NEVER put production values in .env.local, and never run seeds or integration tests with them.

# --- Database (Drizzle / postgres.js) ----------------------------------------
# DATABASE_URL: transaction pooler or direct connection; DIRECT_DATABASE_URL: direct/session (migrations).
DATABASE_URL=
DIRECT_DATABASE_URL=

# --- Supabase API (Auth) -------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by the admin provisioning script and to sign the 12h session cookie. Never expose it to the browser.
SUPABASE_SECRET_KEY=
